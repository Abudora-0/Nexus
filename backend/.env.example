# ── AI backend: "ollama" (fully local) or "gemini" (hosted, free tier) ────────
LLM_PROVIDER=ollama

# ── Ollama  (LLM_PROVIDER=ollama) — the local default ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:1.5b
EMBED_MODEL=nomic-embed-text

# ── Gemini  (LLM_PROVIDER=gemini) — used for the hosted demo, see DEPLOY.md ───
# Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# CHAT_MODEL=gemini-2.0-flash
# EMBED_MODEL=text-embedding-004
# EMBED_DIM=768

# ── CORS: comma-separated frontend origins, or * for local dev ───────────────
ALLOWED_ORIGINS=*
