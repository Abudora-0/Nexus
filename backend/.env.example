# ── Local dev: run everything on Ollama ──────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:1.5b
EMBED_MODEL=nomic-embed-text

# ── Hosted demo: Groq for chat, Gemini for embeddings (see DEPLOY.md) ────────
# Chat and embeddings are chosen independently. Groq has no embeddings API,
# so embeddings run on Gemini's free tier.
#
# CHAT_PROVIDER=groq
# CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=                       # https://console.groq.com/keys
#
# EMBED_PROVIDER=gemini
# EMBED_MODEL=text-embedding-004
# EMBED_DIM=768
# GEMINI_API_KEY=                     # https://aistudio.google.com/apikey

# ── CORS: comma-separated frontend origins, or * for local dev ───────────────
ALLOWED_ORIGINS=*
